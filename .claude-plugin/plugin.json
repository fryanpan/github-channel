{
  "name": "github-claude-channel",
  "version": "1.2.0",
  "description": "GitHub CI, review, and deploy events as Claude Code channel notifications",
  "channels": [
    {
      "server": "github-claude-channel"
    }
  ],
  "mcpServers": {
    "github-claude-channel": {
      "command": "/bin/sh",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/bin/github-channel-mcp.sh",
        "${CLAUDE_PLUGIN_ROOT}/server.ts"
      ]
    }
  }
}
